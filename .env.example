# Application
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
API_PORT=3001

# Database (docker compose :5432 uses trust auth; or `npm run db:up` embedded :54329)
DATABASE_URL=postgresql://avenza@127.0.0.1:54329/avenza
EMBEDDED_PG_PORT=54329
# Optional if your embedded PG tooling requires one (leave empty for local trust-style)
EMBEDDED_PG_PASSWORD=

# Redis
REDIS_URL=redis://127.0.0.1:6379

# Auth — generate locally, never commit real values
# openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=7d
SESSION_SECRET=

# Encryption
# ENCRYPTION_KEY — custody secrets (funding wallet keys, ERP credentials); 64 hex chars
# openssl rand -hex 32
ENCRYPTION_KEY=
# AVENZA_FIELD_ENCRYPTION_KEY — business fields at rest (memos, invoice extraction,
# org registration/email, payee contacts). Required in production. Dev may fall back to JWT_SECRET.
AVENZA_FIELD_ENCRYPTION_KEY=

# Local db:seed only (≥10 chars). Never use this value in production or commit it.
DEMO_SEED_PASSWORD=

# Object storage (S3-compatible / MinIO) — set in .env, not in git
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=avenza-documents
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true
MINIO_ROOT_USER=avenza
MINIO_ROOT_PASSWORD=

# X Layer
XLAYER_CHAIN_ID=1952
XLAYER_RPC_URL=https://testrpc.xlayer.tech/terigon
XLAYER_RPC_URL_FALLBACK=https://xlayertestrpc.okx.com/terigon
# Mainnet: chain 196, https://rpc.xlayer.tech

# Native USDC (never use symbol alone)
USDC_TOKEN_ADDRESS=0xDec90b78111Ba2fc6FC6d84d8B9ec159A2d4b9B3
# Mainnet native USDC: 0xB6CEceAB302E2E4948951eE7843FC24E92933061

# Deploy + relayer (gitignored .env — never commit real keys)
DEPLOYER_PRIVATE_KEY=
RELAYER_PRIVATE_KEY=
TREASURY_ADDRESS=
PAYMENT_AUTHORIZATION_ADDRESS=
PAYMENT_ROUTER_ADDRESS=
AUDIT_REGISTRY_ADDRESS=
ORGANIZATION_REGISTRY_ADDRESS=
VENDOR_REGISTRY_ADDRESS=
PAYMENT_POLICY_REGISTRY_ADDRESS=
CONTROLS_REGISTRY_ADDRESS=
EMERGENCY_CONTROL_ADDRESS=
ORGANIZATION_ONCHAIN_ID=
SETTLEMENT_TAPEOUT_PROCESSOR_ADDRESS=

# TapeOut (defaults: Cerebr processor + AND circuit #1 on X Layer mainnet)
TAPEOUT_FACTORY_ADDRESS=0x1f09daefa827f02cbb40967cc91b259763760761
TAPEOUT_PROCESSOR_ADDRESS=0xB04EB79D1A5EECaabAAfF7B77d7c27578EE693FF
TAPEOUT_PAYMENT_LIMIT_CIRCUIT_ID=1
# Eval reads typically use mainnet TapeOut even when settling on testnet
TAPEOUT_EVAL_CHAIN_ID=196
# false = require live RPC TapeOut eval (required for mainnet / production)
ALLOW_TAPEOUT_LOCAL_FALLBACK=false
PAYMENT_LIMIT_CIRCUIT_ID=1
APPROVAL_THRESHOLD_CIRCUIT_ID=
VENDOR_ELIGIBILITY_CIRCUIT_ID=
TREASURY_CONTROL_CIRCUIT_ID=

# Invoice extraction
EXTRACTION_MODE=heuristic
OPENAI_API_KEY=

# Confirmations before marking payment confirmed (use >=3 on mainnet)
REQUIRED_CONFIRMATIONS=3

# Local demos only — never enable for production funds (simulated path removed from settlement)
ALLOW_SIMULATED_SETTLEMENT=false

# Internal worker auth (required in production — never leave as "dev")
INTERNAL_WEBHOOK_TOKEN=

# API rate limit (requests per IP per minute)
API_RATE_LIMIT_PER_MIN=120

NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# --- Mainnet (X Layer 196) checklist ---
# XLAYER_CHAIN_ID=196
# XLAYER_RPC_URL=https://rpc.xlayer.tech
# USDC_TOKEN_ADDRESS=0xB6CEceAB302E2E4948951eE7843FC24E92933061
# ALLOW_TAPEOUT_LOCAL_FALLBACK=false
# NODE_ENV=production
# Deploy via: XLAYER_CHAIN_ID=196 ./scripts/deploy-xlayer.sh
# Then fill contract addresses from forge broadcast / docs/deployments.md

# Optional: OKLink explorer verification (https://www.oklink.com/docs/en/)
OKLINK_API_KEY=
