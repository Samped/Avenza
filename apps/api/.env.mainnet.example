# AVENZA — X Layer mainnet (196) enterprise production
# Copy to a secrets manager / Fly secrets. Never commit real values.
#
# Generate:
#   openssl rand -hex 32   # JWT / SESSION / INTERNAL_WEBHOOK / ENCRYPTION_KEY
#   openssl rand -base64 48  # AVENZA_FIELD_ENCRYPTION_KEY
#
# Deploy contracts first:
#   CONFIRM_MAINNET_DEPLOY=yes ./scripts/deploy-xlayer.sh
# Then: ./scripts/mainnet-preflight.sh

NODE_ENV=production
PORT=8080
API_PORT=3001
APP_URL=https://YOUR_CONSOLE_HOST
# Optional comma-separated console origins
# CORS_ORIGINS=https://YOUR_CONSOLE_HOST,https://www.YOUR_DOMAIN
API_URL=https://YOUR_API_HOST
ENABLE_SWAGGER=false
API_RATE_LIMIT_PER_MIN=60

DATABASE_URL=postgresql://USER:PASS@HOST/DB?sslmode=require
REDIS_URL=rediss://default:PASS@HOST:6379

JWT_SECRET=
JWT_EXPIRES_IN=7d
SESSION_SECRET=
ENCRYPTION_KEY=
AVENZA_FIELD_ENCRYPTION_KEY=
INTERNAL_WEBHOOK_TOKEN=

XLAYER_CHAIN_ID=196
XLAYER_RPC_URL=https://rpc.xlayer.tech
USDC_TOKEN_ADDRESS=0xB6CEceAB302E2E4948951eE7843FC24E92933061
REQUIRED_CONFIRMATIONS=3
ALLOW_TAPEOUT_LOCAL_FALLBACK=false
ALLOW_SIMULATED_SETTLEMENT=false

TAPEOUT_FACTORY_ADDRESS=0x1f09daefa827f02cbb40967cc91b259763760761
TAPEOUT_PROCESSOR_ADDRESS=0xB04EB79D1A5EECaabAAfF7B77d7c27578EE693FF
TAPEOUT_PAYMENT_LIMIT_CIRCUIT_ID=1
TAPEOUT_EVAL_CHAIN_ID=196
TAPEOUT_RPC_URL=https://rpc.xlayer.tech
SETTLEMENT_TAPEOUT_PROCESSOR_ADDRESS=0xB04EB79D1A5EECaabAAfF7B77d7c27578EE693FF

# Dedicated hot wallet — MUST differ from deployer; fund with OKB for gas only
RELAYER_PRIVATE_KEY=

# After mainnet forge broadcast — paste from deploy log / docs/hackathon/deployed-mainnet.json
EMERGENCY_CONTROL_ADDRESS=
ORGANIZATION_REGISTRY_ADDRESS=
VENDOR_REGISTRY_ADDRESS=
PAYMENT_POLICY_REGISTRY_ADDRESS=
CONTROLS_REGISTRY_ADDRESS=
PAYMENT_AUTHORIZATION_ADDRESS=
PAYMENT_ROUTER_ADDRESS=
TREASURY_ADDRESS=
AUDIT_REGISTRY_ADDRESS=
ORGANIZATION_ONCHAIN_ID=

NEXT_PUBLIC_API_URL=https://YOUR_API_HOST/api/v1
NEXT_PUBLIC_EXPLORER_ADDRESS_BASE=https://www.oklink.com/xlayer/address/
